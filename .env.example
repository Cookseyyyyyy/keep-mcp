# --- Google Keep (unofficial gkeepapi) ---
# Master token has full Google-account access. Treat it like a password.
# Mint one with: uv run keep-mcp-token
GOOGLE_EMAIL=
GOOGLE_MASTER_TOKEN=

# Optional: the shopping-list note Claude should use when no title is given.
KEEP_DEFAULT_LIST=Shopping

# Optional: comma-separated note titles Claude is allowed to mutate.
# Leave empty to allow writes to any list (fine for a personal Keep).
# KEEP_WRITE_TITLES=Shopping

# --- Server / Docker (unRAID) ---
# Bearer token required on the MCP HTTP endpoint.
MCP_AUTH_TOKEN=

# Public HTTPS origin (Cloudflare Tunnel hostname, no path). Required for
# Claude custom connectors (OAuth). Example:
# MCP_PUBLIC_BASE_URL=https://kpr-xxxxxxxx.cooksey.cc
MCP_PUBLIC_BASE_URL=

# Advanced (usually leave unset):
#   PORT            MCP HTTP port (default 8788)
#   KEEP_DATA_DIR   persisted Keep cache + OAuth clients (default ~/.keep-mcp)
